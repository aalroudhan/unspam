# App
PORT=3000
NODE_ENV=development
JWT_SECRET=changeme
INTERCEPTION_MODE=twilio   # "twilio" or "native"

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=unspam
DB_USER=postgres
DB_PASSWORD=postgres

# Scorer
SCORER_URL=http://scorer:8000

# Twilio — required for carrier lookup and call interception
# Sign up at twilio.com — Account SID and Auth Token are on the dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=       # only needed for Mode A (full call interception)
FORWARD_TO_NUMBER=         # only needed for Mode A (your real phone number)

# Email — for sending carrier complaint reports
EMAIL_USER=
EMAIL_PASS=                # Gmail app password (myaccount.google.com → Security → App passwords)
